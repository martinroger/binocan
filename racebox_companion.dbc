CM_ BO_ 1638 "RaceBox GPS Speed, Course Heading, Fix Quality, and Satellites in view";
CM_ BO_ 1639 "RaceBox GPS High-Precision Latitude and Longitude Coordinates (WGS84)";
CM_ BO_ 1640 "RaceBox GPS MSL Altitude, Horizontal Positional Accuracy, and PDOP";
CM_ BO_ 1641 "RaceBox 3-Axis Accelerometer (G-force), Battery Percentage, and Rolling Counter";
CM_ BO_ 1642 "RaceBox 3-Axis Gyroscope Angular Rotation Rates (Roll, Pitch, Yaw)";
CM_ BO_ 1643 "RaceBox GPS UTC Date, Time of Day, and Fractional Centiseconds";
VAL_ 1638 FixStatus 0 "NoFix" 2 "2D_Fix" 3 "3D_Fix" ;
VAL_ 1638 ValidFix 0 "Invalid" 1 "Valid" ;
VAL_ 1638 ValidHeading 0 "Invalid" 1 "Valid" ;
VAL_ 1641 IsCharging 0 "Discharging" 1 "Charging" ;
CM_ BO_ 1644 "Optional (fusion enabled): alignment state machine, validity flags, plausibility scores, rolling counter shared with RB_IMU_ACCEL";
CM_ BO_ 1645 "Optional (fusion enabled): filtered speed, heading of motion, heading rate (clockwise positive) and GNSS-derived longitudinal acceleration";
CM_ BO_ 1646 "Optional (fusion enabled): specific force in the vehicle frame (X forward, Y left, Z up) and learned gravity norm";
CM_ BO_ 1647 "Optional (fusion enabled): bias-corrected angular rate in the vehicle frame (yaw positive for left turns) and yaw 1-sigma";
CM_ BO_ 1648 "Optional (fusion enabled): receiver mounting roll/pitch/yaw, accelerometer gain and cornering-axis error (255 = not enough turns yet)";
CM_ SG_ 1647 FusYawSigma "655.35 = unknown";
CM_ SG_ 1648 FusAccelGain "0 = unknown";
VAL_ 1644 FusState 0 "Unaligned" 1 "LevelCoarse" 2 "Leveled" 3 "Aligned" 4 "Degraded" ;
VAL_ 1644 FusLevelSource 0 "None" 1 "Cruise" 2 "Standstill" 3 "Blend" ;
